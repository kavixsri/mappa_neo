# Copy to .env and fill in your Neo4j AuraDB (free tier) or local Neo4j Bolt credentials
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=YOUR-NEO4J-PASSWORD
NEO4J_DATABASE=neo4j

# Optional production security overrides (required for public deployment / ArgosX scan)
MAPPA_JWT_SECRET=change-this-to-a-long-random-32-plus-char-secret
MAPPA_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://mappa-neo.onrender.com
